      "updated": 1765420657383,
      "link": null,
      "locked": false,
      "text": "There are different ways to use this thread syntax. \n\n\n\n\n1. functions\n2. lambda function\n3. functor\n4. static member function\n6. non static function\n7. how to pass reference in thread of variable",
      "fontSize": 23.539448807699983,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are different ways to use this thread syntax. \n\n\n\n\n1. functions\n2. lambda function\n3. functor\n4. static member function\n6. non static function\n7. how to pass reference in thread of variable",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_TvnlDE6-kmVNWGpp9Neb",
      "type": "text",
      "x": 20693.624811593603,
      "y": -9463.923833742121,
      "width": 307.99957275390625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1695028972,
      "version": 41,
      "versionNonce": 1085308268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765420346845,
      "link": null,
      "locked": false,
      "text": "void printSum(int a , int b) {\n    cout<<a+b<<endl;\n}\nvoid printProduct(int a , int b) {\n    cout<<a*b<<endl;\n}\n\nint main() {\n    thread t1(printSum, 1, 2);\n    thread t2(printProduct, 3, 4);\n    t1.join();\n    t2.join();\n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void printSum(int a , int b) {\n    cout<<a+b<<endl;\n}\nvoid printProduct(int a , int b) {\n    cout<<a*b<<endl;\n}\n\nint main() {\n    thread t1(printSum, 1, 2);\n    thread t2(printProduct, 3, 4);\n    t1.join();\n    t2.join();\n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
