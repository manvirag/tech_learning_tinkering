      "link": null,
      "locked": false,
      "text": "class MyClass {\n    public:   \n    static void printSum(int a , int b) {\n        cout<<a+b<<endl;\n    }\n};\n\nint main() {\n\n    // &MyClass::printSum is the address \n    // of the printSum function\n    thread t1(&MyClass::printSum, 1, 2); \n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class MyClass {\n    public:   \n    static void printSum(int a , int b) {\n        cout<<a+b<<endl;\n    }\n};\n\nint main() {\n\n    // &MyClass::printSum is the address \n    // of the printSum function\n    thread t1(&MyClass::printSum, 1, 2); \n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
