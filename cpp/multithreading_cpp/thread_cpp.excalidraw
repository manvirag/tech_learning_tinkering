      "updated": 1765420381749,
      "link": null,
      "locked": false,
      "text": "int main() {\n\n    // auto printSum = [](int a , int b) {\n    //     cout<<a+b<<endl;\n    // };\n\n\n    thread t1([](int a , int b) {\n        cout<<a+b<<endl;\n    }, 1, 2);\n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int main() {\n\n    // auto printSum = [](int a , int b) {\n    //     cout<<a+b<<endl;\n    // };\n\n\n    thread t1([](int a , int b) {\n        cout<<a+b<<endl;\n    }, 1, 2);\n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
