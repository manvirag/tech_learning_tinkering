      "updated": 1765420416072,
      "link": null,
      "locked": false,
      "text": "// functor (function object) is a class that overloads the () operator\n\nclass PrintSum {\n    public:\n    void operator()(int a , int b) {\n        cout<<a+b<<endl;\n    }\n};\nint main() {\n\n    thread t1(PrintSum(), 1, 2);\n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// functor (function object) is a class that overloads the () operator\n\nclass PrintSum {\n    public:\n    void operator()(int a , int b) {\n        cout<<a+b<<endl;\n    }\n};\nint main() {\n\n    thread t1(PrintSum(), 1, 2);\n    t1.join();   \n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
