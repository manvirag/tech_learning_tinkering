      "seed": 2037443668,
      "version": 262,
      "versionNonce": 710232812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765421419446,
      "link": null,
      "locked": false,
      "text": "JOIN AND DETACH IN THREADS\n\nonce we create thread, it is important to either\njoin it to main thread or deatach it.\nelse in other case it can terminate the main process\nwhile calling thread object destructor",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JOIN AND DETACH IN THREADS\n\nonce we create thread, it is important to either\njoin it to main thread or deatach it.\nelse in other case it can terminate the main process\nwhile calling thread object destructor",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qek_yKIKCGXJqz4ZlVTRr",
      "type": "text",
      "x": 19059.41697003981,
      "y": -7951.159223964053,
      "width": 1047.1995849609375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 556956244,
      "version": 704,
      "versionNonce": 2096804436,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765421564850,
      "link": null,
      "locked": false,
      "text": "Join -> \n- its similar to wait in Golang, we can join particular\n  thread to main thread after calling, it mean it will\n  pause main thread execution until that thread complete\n- if using double join , make sure do with joinable() func. \n  else will break process\n\nDetach -> \n- similar to join, we have detach, it tell main process \n  no need to wait for me, i'll try to complete as much as i can \n  do , and if main process end , this thread will also end. It \n  is possible it will be in middle. \n- similar to join , use joinable() first before using detach again. \n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Join -> \n- its similar to wait in Golang, we can join particular\n  thread to main thread after calling, it mean it will\n  pause main thread execution until that thread complete\n- if using double join , make sure do with joinable() func. \n  else will break process\n\nDetach -> \n- similar to join, we have detach, it tell main process \n  no need to wait for me, i'll try to complete as much as i can \n  do , and if main process end , this thread will also end. It \n  is possible it will be in middle. \n- similar to join , use joinable() first before using detach again. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DZ7bHm2WVX8aO7XZuK60Q",
      "type": "text",
      "x": 20950.91094927577,
      "y": -8049.792877485366,
      "width": 714.86530961637,
      "height": 928.8060413693844,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
