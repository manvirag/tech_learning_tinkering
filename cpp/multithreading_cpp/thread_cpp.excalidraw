      "updated": 1765420634193,
      "link": null,
      "locked": false,
      "text": "\nvoid updateCounter(int &counter){\n    counter++;\n    \n}\nint main(){\n    int counter = 0;\n    thread t1(updateCounter, ref(counter));\n    t1.join();\n    cout<<\"Counter: \"<<counter<<endl;\n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nvoid updateCounter(int &counter){\n    counter++;\n    \n}\nint main(){\n    int counter = 0;\n    thread t1(updateCounter, ref(counter));\n    t1.join();\n    cout<<\"Counter: \"<<counter<<endl;\n    cout<<\"Main thread ends\"<<endl;\n    return 0;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
