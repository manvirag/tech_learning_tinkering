    {
      "id": "i4vZ47hSVK9UzvoGG1SFS",
      "type": "text",
      "x": 19059.61040252486,
      "y": -8276.473756691476,
      "width": 800.7996826171875,
      "height": 210,
      "angle": 0,
      "strokeColor": "#9c36b5",
