      "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Video Call MVP</title>\n</head>\n<body>\n  <h2>Video Call MVP</h2>\n  <video id=\"localVideo\" autoplay muted></video>\n  <video id=\"remoteVideo\" autoplay></video>\n  <br/>\n  <button id=\"startBtn\">Start Call</button>\n  <button id=\"recordBtn\">Start Recording</button>\n  <button id=\"stopRecordBtn\">Stop Recording</button>\n  <a id=\"downloadLink\" download=\"recording.webm\" style=\"display:none\">Download\nRecording</a>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Video Call MVP</title>\n</head>\n<body>\n  <h2>Video Call MVP</h2>\n  <video id=\"localVideo\" autoplay muted></video>\n  <video id=\"remoteVideo\" autoplay></video>\n  <br/>\n  <button id=\"startBtn\">Start Call</button>\n  <button id=\"recordBtn\">Start Recording</button>\n  <button id=\"stopRecordBtn\">Stop Recording</button>\n  <a id=\"downloadLink\" download=\"recording.webm\" style=\"display:none\">Download Recording</a>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>",
      "autoResize": false,
      "lineHeight": 1.25
    },
