    {
      "id": "HDi1BaG6SArvLF0P0OSff",
      "type": "text",
      "x": 3111.709896291807,
      "y": -1116.740957018165,
      "width": 776.2994384765625,
      "height": 1750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
