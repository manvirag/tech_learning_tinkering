      "updated": 1750579382373,
      "link": null,
      "locked": false,
      "text": "Video Transcoder\n\nTranscoding is different from encoding. \nencoding -> change video to some binary format to save data. \ntranscoder -> change vidoe format to different format type mp4 , etc. \n                  + for each type make differnet resoluton 1080p, 720p\n                  + if want it also chunkify , ideally client do this. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Video Transcoder\n\nTranscoding is different from encoding. \nencoding -> change video to some binary format to save data. \ntranscoder -> change vidoe format to different format type mp4 , etc. \n                  + for each type make differnet resoluton 1080p, 720p\n                  + if want it also chunkify , ideally client do this. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
