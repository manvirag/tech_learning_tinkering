    {
      "id": "Z306C4_veyHiWgp8uE5Ta",
      "type": "text",
      "x": 22598.662245573913,
      "y": -13450.523369570907,
      "width": 831.599609375,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1538362739,
      "version": 470,
      "versionNonce": 1197234141,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1764033470296,
      "link": null,
      "locked": false,
      "text": "- Get the robots.txt\n- Get the metadata from db/cache\n- Get the last download timestamp from s3 \n- if already download just update the db \n- else it will check previous download time\n- if less than buffer, push in retry, with delay\n- else fetch html and publish to s3 and update in db. \n- worker will get the cdc event\n- parse the text and publish to s3 \n- parse other url and publish to frontier.\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Get the robots.txt\n- Get the metadata from db/cache\n- Get the last download timestamp from s3 \n- if already download just update the db \n- else it will check previous download time\n- if less than buffer, push in retry, with delay\n- else fetch html and publish to s3 and update in db. \n- worker will get the cdc event\n- parse the text and publish to s3 \n- parse other url and publish to frontier.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
