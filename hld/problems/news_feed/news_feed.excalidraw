      "link": null,
      "locked": false,
      "text": "access pattern\n- add new user entry\n- add relation entry\n- delete relation entry\n- all relation for userId. \n- a node usually 3-5k \n- 3k -> 5nodes. ",
      "fontSize": 7.3709114272021345,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "access pattern\n- add new user entry\n- add relation entry\n- delete relation entry\n- all relation for userId. \n- a node usually 3-5k \n- 3k -> 5nodes. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gaL44MY6hn6nWzWkPGKbe",
      "type": "text",
      "x": -585.1914857158944,
      "y": -1059.7695931976257,
      "width": 76.56793212890625,
      "height": 100.88821979713221,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffc9c9",
