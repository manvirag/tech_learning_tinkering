      "boundElements": null,
      "updated": 1751802703741,
      "link": null,
      "locked": false,
      "text": "cassandra, primary key as user1|user2\nuser1 , follows user2\nStorage -> user table, relation table\nuser table -> 10 column -> 10b -> 100b\n2B -> 2 * 10^11 -> 200GB -> 400GB\n\nrelation -> avg 500 row per person -> each row -> 50b -> 100GB -\n> 200GB \n-> 1TB",
      "fontSize": 6.458257678483616,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cassandra, primary key as user1|user2\nuser1 , follows user2\nStorage -> user table, relation table\nuser table -> 10 column -> 10b -> 100b\n2B -> 2 * 10^11 -> 200GB -> 400GB\n\nrelation -> avg 500 row per person -> each row -> 50b -> 100GB -> 200GB \n-> 1TB",
      "autoResize": false,
      "lineHeight": 1.25
    },
