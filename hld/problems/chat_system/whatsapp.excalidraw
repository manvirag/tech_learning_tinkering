      "seed": 219535721,
      "version": 182,
      "versionNonce": 2033292169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1751988320910,
      "link": null,
      "locked": false,
      "text": "http {\n    upstream websocket_backend {\n        ip_hash;  # enables sticky sessions based on client IP\n\n        server backend1.example.com:8080;\n        server backend2.example.com:8080;\n    }\n\n    server {\n        listen 80;\n\n        location /ws/ {\n            proxy_pass http://websocket_backend;\n\n            # WebSocket headers\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection \"upgrade\";\n            proxy_set_header Host $host;\n\n            proxy_read_timeout 60s;\n        }\n    }\n}",
      "fontSize": 15.18741686240405,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "http {\n    upstream websocket_backend {\n        ip_hash;  # enables sticky sessions based on client IP\n\n        server backend1.example.com:8080;\n        server backend2.example.com:8080;\n    }\n\n    server {\n        listen 80;\n\n        location /ws/ {\n            proxy_pass http://websocket_backend;\n\n            # WebSocket headers\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection \"upgrade\";\n            proxy_set_header Host $host;\n\n            proxy_read_timeout 60s;\n        }\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
