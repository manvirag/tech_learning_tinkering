    {
      "id": "7BPUbrcI47AK-fokbt83j",
      "type": "text",
      "x": 14219.006105186467,
      "y": 451.63500955340146,
      "width": 182.1398468017578,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
