    {
      "id": "Da5605zT21I3XZDhr7_kZ",
      "type": "text",
      "x": 13652.188880208278,
      "y": -71.05540436470723,
      "width": 193.59278809894303,
      "height": 60.361975738921714,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDW",
      "roundness": null,
      "seed": 1142948903,
      "version": 149,
