      "roughness": 0,
      "opacity": 80,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 849719756,
      "version": 482,
      "versionNonce": 1597354612,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1748584216713,
      "link": null,
      "locked": false,
      "text": "How to solve boundary problem\n\nlet say your location geohas prefix is  \"abcd\"\n\nmean we need to find all nearby prefix also.\n\nfor this we can can this prefix to square\n\nlet say after decode its. \n\n(-2,-2).  width = 5\n\nnow with this square we can get all nearby 8 square\n\nlike one can be -7,-7 same width \n\nnow we can change these square to geohash\n\nand find our prefix like query. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to solve boundary problem\n\nlet say your location geohas prefix is  \"abcd\"\n\nmean we need to find all nearby prefix also.\n\nfor this we can can this prefix to square\n\nlet say after decode its. \n\n(-2,-2).  width = 5\n\nnow with this square we can get all nearby 8 square\n\nlike one can be -7,-7 same width \n\nnow we can change these square to geohash\n\nand find our prefix like query. ",
      "autoResize": true,
      "lineHeight": 1.25
    }
