    {
      "id": "U3gUI1tVvFWtYqHRvrzf7",
      "type": "text",
      "x": 5836.057223503416,
      "y": -1711.0274659596655,
      "width": 911.95166015625,
      "height": 855,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
