    {
      "id": "j9WZ4G-Wwp7jdVrp9yXiD",
      "type": "text",
      "x": 19220.201376272424,
      "y": -14022.855588890414,
      "width": 646.7998046875,
      "height": 1015,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 1061925427,
      "version": 659,
      "versionNonce": 1971156042,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770634272663,
      "link": null,
      "locked": false,
      "text": "Distributed Key Value Store: \n\nFR: \n- store key and its value \n\n\nNFR: \n- tunable consistency\n    - read after write consistency.\n    - highly consistent -> same value all \n      place not old value or stale. \n- durable -\n    - once added data not to be deleted\n- fault tolerant\n    - able to restore fast\n- available\n    \n- highly scalable\n- concurrency/parallel requests\n    - can have concurrent operation on\n      same key\n\n- CAP theorem \n\n\n\n\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Distributed Key Value Store: \n\nFR: \n- store key and its value \n\n\nNFR: \n- tunable consistency\n    - read after write consistency.\n    - highly consistent -> same value all \n      place not old value or stale. \n- durable -\n    - once added data not to be deleted\n- fault tolerant\n    - able to restore fast\n- available\n    \n- highly scalable\n- concurrency/parallel requests\n    - can have concurrent operation on\n      same key\n\n- CAP theorem \n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
