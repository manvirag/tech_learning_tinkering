    {
      "id": "ZhpB9chezoypToWy-EdZ8",
      "type": "text",
      "x": 21344.975231850134,
      "y": -14288.117965181302,
      "width": 165,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
