      "text": "- retry with exponential fail. \n- logging.\n- monitoring about state size, latency, cleanup",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- retry with exponential fail. \n- logging.\n- monitoring about state size, latency, cleanup",
      "autoResize": true,
