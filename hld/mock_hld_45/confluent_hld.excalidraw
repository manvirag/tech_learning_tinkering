      "link": null,
      "locked": false,
      "text": "NFR: \n- scalable \n- highly available. \n- its ok add episode -> upload -> slower . \n- alerts and monitoring. \n- max subscribtion ?? \n- episodes -> durable -> \n- very old episode scrolling -> its ok bit slow. to save storage\n- max size of podcast ? \n\nEstimations: \n- Storage : \n- feed qps ? \n- peak feed qps \n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR: \n- scalable \n- highly available. \n- its ok add episode -> upload -> slower . \n- alerts and monitoring. \n- max subscribtion ?? \n- episodes -> durable -> \n- very old episode scrolling -> its ok bit slow. to save storage\n- max size of podcast ? \n\nEstimations: \n- Storage : \n- feed qps ? \n- peak feed qps \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
