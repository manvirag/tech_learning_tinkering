      "seed": 1451465942,
      "version": 658,
      "versionNonce": 355072906,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769924974553,
      "link": null,
      "locked": false,
      "text": "Database. Schema:\n\n- User\n    -id \n    -name ... \n\n- RssFeed\n    - id \n    - name/title\n    - addedTime\n    - endPointUrl \n    - ... \n\n- RssFeedArticle\n    - id \n    - hashId \n    - title\n    - createdTime\n    - contentUrl -> can be either s3 or direct in db as well \n                       might require bit research \n    - rssFeedId \n\n- Subscription\n     - id \n     - userid\n     - rssFeedId \n\n- UserRead \n    - id \n    - userId \n    - rssFeedArticleId\n    - read // boolean \n\n- UserRssLabel ( 1:1 -> atmax 1 label to article ) \n    - id '\n    - userId \n    - rssFeedArticleId\n    - labelValue // string\n\n\n\n\n ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Database. Schema:\n\n- User\n    -id \n    -name ... \n\n- RssFeed\n    - id \n    - name/title\n    - addedTime\n    - endPointUrl \n    - ... \n\n- RssFeedArticle\n    - id \n    - hashId \n    - title\n    - createdTime\n    - contentUrl -> can be either s3 or direct in db as well \n                       might require bit research \n    - rssFeedId \n\n- Subscription\n     - id \n     - userid\n     - rssFeedId \n\n- UserRead \n    - id \n    - userId \n    - rssFeedArticleId\n    - read // boolean \n\n- UserRssLabel ( 1:1 -> atmax 1 label to article ) \n    - id '\n    - userId \n    - rssFeedArticleId\n    - labelValue // string\n\n\n\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
