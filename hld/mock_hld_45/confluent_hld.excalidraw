    {
      "id": "7gpk9tBsZy6S0JnrvadtZ",
      "type": "text",
      "x": 6213.078209803246,
      "y": 9319.984446872593,
      "width": 1180.093989126978,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
