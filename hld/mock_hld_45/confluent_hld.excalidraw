    {
      "id": "Tot-DYzg0zv95oLMp5wMv",
      "type": "text",
      "x": 8420.269889322104,
      "y": 11687.398888196964,
      "width": 429.8876953125,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
