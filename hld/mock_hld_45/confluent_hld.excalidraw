      "boundElements": [],
      "updated": 1769924373372,
      "link": null,
      "locked": false,
      "text": "Database Schema: \n\nUser ( loggedin User ) \n- id\n- email \n- name \n- username \n\nUserEmailRequest\n- id \n- userId \n- creationTime\n- status\n\nUserGeneratedEmail \n- id\n- userId \n- generatedEmail \n- creationTime \n- deletionTime \n- requestId\n\n\nUserEmailInboxes\n-  Id \n- userId\n- userGeneratedEmailId \n- messageJson\n- time \n\n\nmessageJson: {\n    Subject:\n    Sender: \n    Message: \n    etc.  \n}\n\n\nDomain\n- id \n- name // abc , par2 \n- addedTime \n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Database Schema: \n\nUser ( loggedin User ) \n- id\n- email \n- name \n- username \n\nUserEmailRequest\n- id \n- userId \n- creationTime\n- status\n\nUserGeneratedEmail \n- id\n- userId \n- generatedEmail \n- creationTime \n- deletionTime \n- requestId\n\n\nUserEmailInboxes\n-  Id \n- userId\n- userGeneratedEmailId \n- messageJson\n- time \n\n\nmessageJson: {\n    Subject:\n    Sender: \n    Message: \n    etc.  \n}\n\n\nDomain\n- id \n- name // abc , par2 \n- addedTime \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
