    {
      "id": "kWa5-3flHgkHbO7_ENfiA",
      "type": "text",
      "x": 3360.4686843048767,
      "y": 9586.838701710723,
      "width": 1465.8360648423434,
      "height": 552.0139156983532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
