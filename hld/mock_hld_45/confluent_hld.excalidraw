    {
      "id": "wVrBpilJTEalA-WJYXL18",
      "type": "text",
      "x": -1969.2292338169318,
      "y": 9310.465179013012,
      "width": 1892.8204632097388,
      "height": 758.6654407901318,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
