      "seed": 1882302753,
      "version": 449,
      "versionNonce": 791839233,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1750480670204,
      "link": null,
      "locked": false,
      "text": "    1. Seach with the movie title -> list of shows which present that movie. \n    2. custoerm -> book movie seat -> these seat are limited \n    3. once seat is booked  -> its not available for other.\n    4. add the movie details by admin\n    ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    1. Seach with the movie title -> list of shows which present that movie. \n    2. custoerm -> book movie seat -> these seat are limited \n    3. once seat is booked  -> its not available for other.\n    4. add the movie details by admin\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
