      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 2112753247,
      "version": 364,
      "versionNonce": 1653623697,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746695182325,
      "link": null,
      "locked": false,
      "text": "Schema: \n1. Id\n2. scheduled\n3. shardedId = 1 -> scale work\n\n\ncoordination -> worker -> separated by queue. partitions\nfetch message -> \n\n40k qps * 60 * 10\n\n\n\n\n\nWorker -> job \n\nt -> 12:00 -> current\nt` -> 11:50\n\nselect * from notfication\nwhere schduled >= t1 \nshardedId = ''\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Schema: \n1. Id\n2. scheduled\n3. shardedId = 1 -> scale work\n\n\ncoordination -> worker -> separated by queue. partitions\nfetch message -> \n\n40k qps * 60 * 10\n\n\n\n\n\nWorker -> job \n\nt -> 12:00 -> current\nt` -> 11:50\n\nselect * from notfication\nwhere schduled >= t1 \nshardedId = ''\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
