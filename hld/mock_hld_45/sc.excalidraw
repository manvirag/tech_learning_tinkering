      "updated": 1746693501791,
      "link": null,
      "locked": false,
      "text": "notfication db -> request -> Idempotnet, status\n1. write request -> 20kqps\n2. read. \nwith with help of notifcation Id  with status -> \n3. consistenct status -> MYSQL -> shard with notificationId.  -> btree\n\nwrite heavye system -> lst for write heavey\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "notfication db -> request -> Idempotnet, status\n1. write request -> 20kqps\n2. read. \nwith with help of notifcation Id  with status -> \n3. consistenct status -> MYSQL -> shard with notificationId.  -> btree\n\nwrite heavye system -> lst for write heavey\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wSt9Adqz6xcg-g29q3Mlr",
      "type": "text",
      "x": 1644.4727419662756,
      "y": -1309.6788473388365,
      "width": 700.0154418945312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
