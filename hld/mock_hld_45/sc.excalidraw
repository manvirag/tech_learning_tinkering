    {
      "id": "e4V34AyFzKqTvyLTSm4sJ",
      "type": "text",
      "x": 2133.8491674300967,
      "y": -163.78895703862946,
      "width": 441.93560791015625,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
