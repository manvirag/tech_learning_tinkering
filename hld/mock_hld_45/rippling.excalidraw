      "seed": 1861804017,
      "version": 208,
      "versionNonce": 869701137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763217179757,
      "link": null,
      "locked": false,
      "text": "- HotelReservation\n    - Id\n    - hotelRoomTypeId\n    - reserveCount\n    - startDate\n    - endDate\n    - status \n    - userId \n    - advancePaymentAmount\n    - price\n    - md. \n\n- Invoice\n    - Id \n    - hotelReservationId\n    - HotelRoomInventoryPriceId\n    - createdTime\n    - tax\n    - bookingAmount\n    - totalAmount.\n    - otherDetails.\n\n- Payment\n    - Id \n    - invoiceId\n    - amount\n    - userId \n    - status",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
