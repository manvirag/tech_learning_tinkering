      "link": null,
      "locked": false,
      "text": "storage\n- userrow -> 25*10 -> 250B \n             1b -> 250B bytes -> 250GB\n              -> let say one instance -> 50TB\n              \n\n- relation -> 20 -> 500avg -> 500*20*1B -> 1TB \n- posts -> url -> 50B + 50B ( other ) * 1B -> 100GB per day. -> 5 years -> 5*400*100 -> 200TB",
      "fontSize": 106.47191542806902,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "storage\n- userrow -> 25*10 -> 250B \n             1b -> 250B bytes -> 250GB\n              -> let say one instance -> 50TB\n              \n\n- relation -> 20 -> 500avg -> 500*20*1B -> 1TB \n- posts -> url -> 50B + 50B ( other ) * 1B -> 100GB per day. -> 5 years -> 5*400*100 -> 200TB",
      "autoResize": true,
      "lineHeight": 1.25
    },
