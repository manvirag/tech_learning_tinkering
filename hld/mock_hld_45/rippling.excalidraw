    {
      "id": "YtETvHHPWOAizWaLBptM8",
      "type": "text",
      "x": 28325.05709517319,
      "y": 240.32816228839374,
      "width": 1445.399169921875,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
