    {
      "id": "Fgl3-CUAaurEvPPjrl5WM",
      "type": "text",
      "x": 25489.46576546996,
      "y": 5199.095850744749,
      "width": 750.5376478089103,
      "height": 1986.7647825393797,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
