      "seed": 1991767286,
      "version": 780,
      "versionNonce": 527995306,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746633910330,
      "link": null,
      "locked": false,
      "text": "api\n- api/v1/chat/listchats\n- api/v1/chat/createChat\n- api/v1/chat/connection -> ws::api/v1/chat/connection\nu1- ws://api/v1/chat/connection\nsendmessage -> \"fdsf\"\nu2- ws://api/v1/chat/connection\nreceivedmessage -> \"fds\"\nsendmessage -> ...\n- api/v1/chat/messages?chatid=''&&size='10'\n    fetch message for chat past 10 either send or receiver\n    update each message state to read\n- api/v1/chat/group\n- api/v1/chat/createGroup\n- \n\n\n\nlogic\nsend -> insert into chat application\nsend this to pubsub queue\nconsumer on websocket -> consume this queue.\nlike in slack it can be consumer of channelid\nsee all people in channel\nfannout -> may be via worker\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "api\n- api/v1/chat/listchats\n- api/v1/chat/createChat\n- api/v1/chat/connection -> ws::api/v1/chat/connection\nu1- ws://api/v1/chat/connection\nsendmessage -> \"fdsf\"\nu2- ws://api/v1/chat/connection\nreceivedmessage -> \"fds\"\nsendmessage -> ...\n- api/v1/chat/messages?chatid=''&&size='10'\n    fetch message for chat past 10 either send or receiver\n    update each message state to read\n- api/v1/chat/group\n- api/v1/chat/createGroup\n- \n\n\n\nlogic\nsend -> insert into chat application\nsend this to pubsub queue\nconsumer on websocket -> consume this queue.\nlike in slack it can be consumer of channelid\nsee all people in channel\nfannout -> may be via worker\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
