      "seed": 1101823530,
      "version": 182,
      "versionNonce": 1328970794,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746597000814,
      "link": null,
      "locked": false,
      "text": "Api design: \n\n1.    Create coupan api. \n2.   deactive coupan api.\n3.   fetch coupans ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Api design: \n\n1.    Create coupan api. \n2.   deactive coupan api.\n3.   fetch coupans ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "udxhTLdim5JSiOHn3LaCv",
      "type": "text",
      "x": 821.0395915435313,
      "y": 364.4159051506508,
      "width": 313.2797546386719,
      "height": 820,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1620472362,
      "version": 787,
      "versionNonce": 1680434922,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746597000814,
      "link": null,
      "locked": false,
      "text": "fetch coupan\n\nPaginated api\n\n/api/v1/coupan/fetchcoupans      POST\n\nheader : x-token -> validate\n\nRequest: {\n    requestMeta: {\n        appname: \"\"\n        globalContextId: \"\"\n    }, \n    filters: {\n      restaurentId: \n      paymentGateWayId: \n      cartValue: <>\n    },\n    pageSize: <>\n    offset: <>\n}\n\n\nResponse: {\n\n   pageSize: \n   offset: \n   hits: [\n    {\n        id: \"123\",\n        usageTimes: \"1\"\n        appliedTime: \"10May2025\".\n        discountType: PERCENTAGE\n        discount: 5\n        maxDiscount: 50\n    }\n \n   ]\n   \n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fetch coupan\n\nPaginated api\n\n/api/v1/coupan/fetchcoupans      POST\n\nheader : x-token -> validate\n\nRequest: {\n    requestMeta: {\n        appname: \"\"\n        globalContextId: \"\"\n    }, \n    filters: {\n      restaurentId: \n      paymentGateWayId: \n      cartValue: <>\n    },\n    pageSize: <>\n    offset: <>\n}\n\n\nResponse: {\n\n   pageSize: \n   offset: \n   hits: [\n    {\n        id: \"123\",\n        usageTimes: \"1\"\n        appliedTime: \"10May2025\".\n        discountType: PERCENTAGE\n        discount: 5\n        maxDiscount: 50\n    }\n \n   ]\n   \n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_b4heIpWwRD5JzeJd0rzD",
      "type": "text",
      "x": 1415.9231274321332,
      "y": 250.5441112512853,
      "width": 437.0717468261719,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "b2J",
