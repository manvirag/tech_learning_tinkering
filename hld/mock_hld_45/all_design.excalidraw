      "seed": 1766587818,
      "version": 369,
      "versionNonce": 418445738,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746597000814,
      "link": null,
      "locked": false,
      "text": "Db scheme\n\n1. Coupan\n - id <uuid> \n - createdTime\n - updatedTime\n - cartValue\n - usageTimes\n - appliedTime\n - maxDiscount\n - discount -> \"5\" -> 5%, 5cashback, 5off\n - discountType -> // PERCENTAGE, CASHBACK, FLAT \n - status",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Db scheme\n\n1. Coupan\n - id <uuid> \n - createdTime\n - updatedTime\n - cartValue\n - usageTimes\n - appliedTime\n - maxDiscount\n - discount -> \"5\" -> 5%, 5cashback, 5off\n - discountType -> // PERCENTAGE, CASHBACK, FLAT \n - status",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WWc66XnMlqzuJQ5NKF9fE",
