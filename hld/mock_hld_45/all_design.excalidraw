    {
      "id": "Oj8uXvaCNtVr1CeoHu1a2",
      "type": "text",
      "x": 3779.9338183167547,
      "y": 2079.398537285643,
      "width": 65.26393127441406,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
