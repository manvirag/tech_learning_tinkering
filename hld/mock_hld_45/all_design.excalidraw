      "versionNonce": 562903402,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1746597000814,
      "link": null,
      "locked": false,
      "text": "1. customer perspecgive -> UI -> perpare the cart with payment type -> fetch all coupans related to that card  and user \n2. apply a coupan on that cart and price go reduce. \n3. is usageTime specific to what ? user or restaurent. like user already used one coupan , how we wanna behave on UI ? \n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. customer perspecgive -> UI -> perpare the cart with payment type -> fetch all coupans related to that card  and user \n2. apply a coupan on that cart and price go reduce. \n3. is usageTime specific to what ? user or restaurent. like user already used one coupan , how we wanna behave on UI ? \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eFh2eAEpGxr8ecIlCZwmo",
      "type": "text",
      "x": 823.4916953302803,
      "y": 234.47312280246763,
      "width": 191.63182067871094,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
