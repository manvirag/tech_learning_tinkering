      "boundElements": [],
      "updated": 1768026492584,
      "link": null,
      "locked": false,
      "text": "i am self learner\n-> if things availabe on internet i can learn\n-> if i found something which require infrastructure etc \n-> yes i want to go in AI deep dive -> phd might help me in it.\n\nalternate -> side by side learn ai things -> jion some bit mnc\nlike deepmind etc -> work hard there they also do reasearch + earnings",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i am self learner\n-> if things availabe on internet i can learn\n-> if i found something which require infrastructure etc \n-> yes i want to go in AI deep dive -> phd might help me in it.\n\nalternate -> side by side learn ai things -> jion some bit mnc\nlike deepmind etc -> work hard there they also do reasearch + earnings",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IRahFTg-6Z8eH_iMpUu00",
      "type": "text",
      "x": -130.48315484987552,
      "y": 8354.51084419344,
      "width": 2103.839599609375,
      "height": 585,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
