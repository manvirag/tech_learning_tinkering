    {
      "id": "jur4s-8uKPTdSLyYeWJBP",
      "type": "text",
      "x": -795.4186281168712,
      "y": 11301.842250864816,
      "width": 1078.2999267578125,
      "height": 363.8731602398696,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
