      "updated": 1766662517369,
      "link": null,
      "locked": false,
      "text": "-> How much time uptil now ? (15min more, will back on this ) \n-> Note we haven't added any logic here. \n\nFor machine coding: ( overall 30-40 mins with logic )\n\nIn above step better to do complete flow one by one\ninstead of write all service laery and functions\nbetter write one service layer and its dao\nand write its logic and make it run then add more.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> How much time uptil now ? (15min more, will back on this ) \n-> Note we haven't added any logic here. \n\nFor machine coding: ( overall 30-40 mins with logic )\n\nIn above step better to do complete flow one by one\ninstead of write all service laery and functions\nbetter write one service layer and its dao\nand write its logic and make it run then add more.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
