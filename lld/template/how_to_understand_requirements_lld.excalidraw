      "updated": 1766660194004,
      "link": null,
      "locked": false,
      "text": "Models:\n\nclass client\n  int id;\n  string name;\n  int registerTime;\n  list<Bank> integratedBank;\n  list<PaymentMethods> paymentMethods;\n  PMRoutingCriteria clientRoutingC;\n \nenum Banktype {\n        'HDFC',\n        'SBI',\n        'ICICI'\n}\n\ninterface <<Bank> {}\n   \n\n\nclass HDFCBank \n     Banktype type\n     HDFCIntegrationDetails integration\n    \n\nclass SBIBank \n     Banktype type\n     SBIIntegrationDetails integration\n\n\ninterface BankDetails {}\nclass HDFCIntegrationDetails{}\nclass SBIIntegrationDetails{}\n\nEnum PaymentMethodType -> 'UPI', 'CREDIT_CARD', 'DEBIT_CARD', 'NET_BANKING'\n\n<<PaymentMethod>>\n    - PaymentMethodType\n\nUPIPaymentMethod\n    -> string vpa\nCreditCardPaymentMethod\n    -> string number\n    -> string expiryDate\n    -> int cvv\n\n\nPMRoutingCriteria:\n\n- map<PaymentMethodType, RoutingRule > map\n\n\n\n<<RoutingRule>>\n\nDistribution\n- list<bank> \n- map<bankId, percentage>\n\n\n\nServiceLayers and Dao Layer: \n\n- clientSerivce \n        clientDao\n    - addClient(name, list<bankDto>, list<paymentmethod>)\n    - removeClient(name)\n\n- Pyamentgatewasyservice\n        clientDao\n        pyamentDao\n    - hasClient(clientName)\n    - makePayment(amount, client, paymentMethod)\n    - removePaymentmode(Paymenttype , client)\n    - addPaymentmode(Paymenttype, client)\n    \n\n\n\nDaoLayer\n  - clientDao\n        map<int,client> \n  - PaymentGatewaydao\n        list<paymentmehtod>\n        list<bank>\n  - bankDao\n        map<int, Bank>\n   \n \n\n\n\n\n\n\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Models:\n\nclass client\n  int id;\n  string name;\n  int registerTime;\n  list<Bank> integratedBank;\n  list<PaymentMethods> paymentMethods;\n  PMRoutingCriteria clientRoutingC;\n \nenum Banktype {\n        'HDFC',\n        'SBI',\n        'ICICI'\n}\n\ninterface <<Bank> {}\n   \n\n\nclass HDFCBank \n     Banktype type\n     HDFCIntegrationDetails integration\n    \n\nclass SBIBank \n     Banktype type\n     SBIIntegrationDetails integration\n\n\ninterface BankDetails {}\nclass HDFCIntegrationDetails{}\nclass SBIIntegrationDetails{}\n\nEnum PaymentMethodType -> 'UPI', 'CREDIT_CARD', 'DEBIT_CARD', 'NET_BANKING'\n\n<<PaymentMethod>>\n    - PaymentMethodType\n\nUPIPaymentMethod\n    -> string vpa\nCreditCardPaymentMethod\n    -> string number\n    -> string expiryDate\n    -> int cvv\n\n\nPMRoutingCriteria:\n\n- map<PaymentMethodType, RoutingRule > map\n\n\n\n<<RoutingRule>>\n\nDistribution\n- list<bank> \n- map<bankId, percentage>\n\n\n\nServiceLayers and Dao Layer: \n\n- clientSerivce \n        clientDao\n    - addClient(name, list<bankDto>, list<paymentmethod>)\n    - removeClient(name)\n\n- Pyamentgatewasyservice\n        clientDao\n        pyamentDao\n    - hasClient(clientName)\n    - makePayment(amount, client, paymentMethod)\n    - removePaymentmode(Paymenttype , client)\n    - addPaymentmode(Paymenttype, client)\n    \n\n\n\nDaoLayer\n  - clientDao\n        map<int,client> \n  - PaymentGatewaydao\n        list<paymentmehtod>\n        list<bank>\n  - bankDao\n        map<int, Bank>\n   \n \n\n\n\n\n\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
